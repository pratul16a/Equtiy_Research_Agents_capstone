# === LLM Provider (at least one required) ===
GOOGLE_API_KEY=your_google_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# === Optional: News API ===
# NEWSAPI_KEY=your_newsapi_key_here

# === Optional: LangSmith Tracing ===
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_TRACING=true

# === Model Overrides (defaults shown) ===
# LLM_MODEL=gemini-2.0-flash
# EMBEDDING_MODEL=models/embedding-001

# === Optional: Email Sharing (Gmail SMTP) ===
# SMTP_EMAIL=your_gmail@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# === Optional: WhatsApp Sharing (Twilio) ===
# 1. Create free account at https://twilio.com
# 2. Go to Console > Messaging > WhatsApp Sandbox
# 3. Send "join <sandbox-code>" from your phone to the Twilio number
# 4. Copy credentials below:
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_DEFAULT_PHONE=919876543210
